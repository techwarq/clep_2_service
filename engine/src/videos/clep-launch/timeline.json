  "vo": [
    {
      "file": "vo_00_ca873b2c7a.mp3",
      "start": 0.6,
      "text": "You shipped the feature."
    },
    {
      "file": "vo_01_944332ff88.mp3",
      "start": 2.6,
      "text": "But the demo? Still on your to-do list."
    },
    {
      "file": "vo_02_46eef0bdba.mp3",
      "start": 5.6,
      "text": "Because every demo is the same grind. Record. Retake. Zoom. Crop. Export."
    },
    {
      "file": "vo_03_a351436c61.mp3",
      "start": 12.5,
      "text": "And the moment your UI changes, you do it all again."
    },
    {
      "file": "vo_04_c7b5e85ae9.mp3",
      "start": 16.5,
      "text": "But your code already knows what your feature does."
    },
    {
      "file": "vo_05_ffc24947ec.mp3",
      "start": 21.0,
      "text": "Meet clep. Product demos, straight from your code."
    },
    {
      "file": "vo_06_4abd998dc5.mp3",
      "start": 25.4,
      "text": "Just ask Claude Code."
    },
    {
      "file": "vo_07_665ad9a0a7.mp3",
      "start": 29.2,
      "text": "Clep finds the feature, runs it in a real browser, and directs every click."
    },
    {
      "file": "vo_08_bc5f2487aa.mp3",
      "start": 35.4,
      "text": "What comes back is a finished film. Edited, graded, 1080p."
    },
    {
      "file": "vo_09_77f1398cb3.mp3",
      "start": 41.2,
      "text": "Build it. Clep it. Share it."
    }
  ],
